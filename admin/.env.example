# reCAPTCHA v2 Configuration
# Lấy Site Key và Secret Key từ: https://www.google.com/recaptcha/admin
# Giá trị dưới đây là KEY TEST CÔNG KHAI của Google (luôn pass) - chỉ dùng cho dev.
# Server phải dùng site key thật và BE phải verify token bằng secret key.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Backend API (chỉ dùng cho proxy khi chạy `npm run dev`; bản build gọi /api cùng origin qua Nginx)
VITE_API_BASE=http://localhost:3000

# TURN server cho video call (tuỳ chọn, nên có ở production).
# Mọi biến VITE_* đều nằm trong bundle JS, người dùng xem được.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
